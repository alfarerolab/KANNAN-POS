# ============================================================
# KANNAN POS — Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas tu .env real al repositorio.
# ============================================================

# ── Base de datos ────────────────────────────────────────────
# Formato: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL="mysql://USER:STRONG_PASSWORD@127.0.0.1:3306/database_name"

# ── NextAuth ─────────────────────────────────────────────────
# URL pública de la aplicación (sin / al final)
NEXTAUTH_URL="https://tu-dominio.com"

# Secret para firmar tokens JWT.
# GENERAR CON: openssl rand -base64 64
# Mínimo 64 caracteres. NUNCA usar un valor predecible.
NEXTAUTH_SECRET="genera-con-openssl-rand-base64-64"

# ── URLs públicas (opcionales) ────────────────────────────────
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"
NEXT_PUBLIC_API_URL="https://tu-dominio.com/api"

# ── Redis (para rate limiting persistente) ────────────────────
# Instalar Redis: sudo apt install redis-server
# REDIS_URL="redis://127.0.0.1:6379"

# ── NUNCA agregar estas variables en producción ───────────────
# IS_ELECTRON=true         ← bypasea toda la autenticación
# DISABLE_ACCOUNT_CHECKS=true ← deshabilita validaciones de suscripción
